{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DiscoveryCandidate",
  "description": "Schema for an HTML5 game discovered through the automated discovery pipeline.",
  "type": "object",
  "required": [
    "candidateId",
    "name",
    "originalRepoUrl",
    "author",
    "discoveryDate",
    "licenseName",
    "licensingStatus",
    "securityStatus",
    "publicationEligibility",
    "reviewerDecision"
  ],
  "properties": {
    "candidateId": {
      "type": "string",
      "description": "Unique stable identifier for the candidate (e.g. slugified author-repo or hash)."
    },
    "name": {
      "type": "string",
      "description": "Human-readable game title."
    },
    "originalRepoUrl": {
      "type": "string",
      "format": "uri",
      "description": "Canonical public repository or project URL."
    },
    "author": {
      "type": "string",
      "description": "Original developer, creator, or organization."
    },
    "description": {
      "type": "string",
      "description": "Short summary of gameplay mechanics and theme."
    },
    "discoveryDate": {
      "type": "string",
      "format": "date",
      "description": "ISO date of initial discovery."
    },
    "lastUpdateDate": {
      "type": "string",
      "description": "ISO date of latest commit, release, or repository update."
    },
    "sourcePlatform": {
      "type": "string",
      "enum": ["github", "itch.io", "phaser-community", "open-source-hub"],
      "description": "Origin of discovery."
    },
    "programmingLanguage": {
      "type": "string",
      "description": "Primary code language (e.g. JavaScript, TypeScript)."
    },
    "gameEngine": {
      "type": "string",
      "description": "Engine or framework (e.g. Vanilla Canvas2D, WebGL, Phaser, PixiJS, Three.js)."
    },
    "popularityIndicators": {
      "type": "object",
      "properties": {
        "githubStars": { "type": "number" },
        "forks": { "type": "number" },
        "openIssues": { "type": "number" },
        "communityPlays": { "type": "number" },
        "trendVelocity": { "type": "string" },
        "signalsSource": { "type": "string" },
        "signalsDate": { "type": "string" }
      }
    },
    "licenseName": {
      "type": "string",
      "description": "SPDX identifier or license name."
    },
    "licenseUrl": {
      "type": "string",
      "description": "URL to the license file in the repository."
    },
    "licensingStatus": {
      "type": "string",
      "enum": ["VERIFIED_COMMERCIAL_USE", "RESTRICTED", "UNKNOWN", "REJECTED"],
      "description": "Mandatory licensing gate evaluation."
    },
    "assetLicensingStatus": {
      "type": "string",
      "description": "Verification status of graphics, audio, fonts, and external assets."
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Runtime npm or script dependencies."
    },
    "html5Compatibility": {
      "type": "boolean",
      "description": "Whether game runs cleanly in standard HTML5 browser environment."
    },
    "mobileCompatibility": {
      "type": "boolean",
      "description": "Whether game provides touch inputs and responsive layout."
    },
    "scores": {
      "type": "object",
      "properties": {
        "popularityScore": { "type": "number", "minimum": 0, "maximum": 25 },
        "technicalQualityScore": { "type": "number", "minimum": 0, "maximum": 20 },
        "mobileScore": { "type": "number", "minimum": 0, "maximum": 15 },
        "maintenanceScore": { "type": "number", "minimum": 0, "maximum": 15 },
        "relevanceScore": { "type": "number", "minimum": 0, "maximum": 15 },
        "standaloneScore": { "type": "number", "minimum": 0, "maximum": 10 },
        "totalScore": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "securityStatus": {
      "type": "string",
      "enum": ["PASSED", "SECURITY_REVIEW", "NEEDS_MANUAL_REVIEW", "REJECTED"],
      "description": "Mandatory security gate evaluation."
    },
    "securityFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
          "category": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "publicationEligibility": {
      "type": "string",
      "enum": ["ELIGIBLE", "INELIGIBLE"],
      "description": "Automatic computation based strictly on Licensing + Security gates."
    },
    "reviewerDecision": {
      "type": "string",
      "enum": ["PENDING_REVIEW", "APPROVE", "REJECT", "REQUEST_MORE_INFORMATION"],
      "description": "Explicit human reviewer decision on GitHub PR."
    },
    "reviewNotes": {
      "type": "string",
      "description": "Human reviewer notes, caveats, or test observations."
    },
    "exactCommitHash": {
      "type": "string",
      "description": "Specific Git commit SHA audited and approved."
    }
  }
}